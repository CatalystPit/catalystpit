{
 "crons": [
    {
      "path": "/api/refresh",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/refresh-content",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/refresh-congress",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/prewarm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/prewarm-tickers",
      "schedule": "*/15 13-20 * * 1-5"
    },
    {
      "path": "/api/cron/prewarm-tickers",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/sync-short-interest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/pit-snapshot",
      "schedule": "*/15 13-20 * * 1-5"
    },
    {
      "path": "/api/cron/pit-snapshot",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/insider-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/brief",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/cron/institutions",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://s3.tradingview.com https://*.tradingview.com https://www.googletagmanager.com https://*.clerk.accounts.dev https://*.clerk.com https://clerk.catalystpit.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.anthropic.com https://upstash.io https://powerful-grouper-86116.upstash.io https://*.clerk.accounts.dev https://*.clerk.com https://clerk.catalystpit.com https://challenges.cloudflare.com; frame-src 'self' https://www.tradingview.com https://*.tradingview.com https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com https://docs.google.com; frame-ancestors 'none'; worker-src 'self' blob:;" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://catalystpit.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "functions": {
    "src/app/api/refresh/route.js": {
      "maxDuration": 30
    },
    "src/app/api/refresh-content/route.js": {
      "maxDuration": 60
    },
    "src/app/api/refresh-congress/route.js": {
      "maxDuration": 60
    },
    "src/app/api/prewarm/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/prewarm-tickers/route.js": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync-short-interest/route.js": {
      "maxDuration": 300
    },
    "src/app/api/claude/route.js": {
      "maxDuration": 10
    },
    "src/app/api/cron/pit-snapshot/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/insider-alerts/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/brief/route.js": {
      "maxDuration": 30
    },
    "src/app/api/cron/institutions/route.js": {
      "maxDuration": 300
    }
  }
}
